# API Environment Variables

# Server
PORT=4000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://campus:campus_secret@localhost:5432/campusconnect"

# JWT Secrets (generate with: openssl rand -base64 64)
JWT_ACCESS_SECRET=your_access_secret_here_min_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_here_min_32_chars
OTP_SECRET=your_otp_hmac_secret_here_min_32_chars

# JWT Expiry
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS
WEB_ORIGIN=http://localhost:3000

# Email (Mailpit for dev)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@campusconnect.local

# App
APP_URL=http://localhost:3000
ALLOWED_EMAIL_DOMAINS=cb.amrita.edu,am.amrita.edu,amrita.edu

# Cloudflare R2 Storage (S3-Compatible)
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_TOKEN=your_r2_api_token
R2_BUCKET_NAME=amrita-plexus
